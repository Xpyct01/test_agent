# Copy to .env and fill in. Every variable is documented in README.md.

# --- OpenAI (required) ---
TRIP_OPENAI_API_KEY=sk-...
# TRIP_OPENAI_BASE_URL=

# --- Agents ---
# TRIP_AGENTS_MODEL_NAME=gpt-4.1-mini
# TRIP_AGENTS_HUMAN_MODEL_NAME=gpt-4.1-mini
# TRIP_AGENTS_TEMPERATURE=0.0
# TRIP_AGENTS_SEED=42
# TRIP_AGENTS_RECURSION_LIMIT=40
# TRIP_AGENTS_MAX_RETRIES=3
# TRIP_AGENTS_REQUEST_TIMEOUT_S=60
# TRIP_AGENTS_INPUT_COST_PER_MILLION=0.4
# TRIP_AGENTS_OUTPUT_COST_PER_MILLION=1.6

# --- Simulation ---
# TRIP_SIMULATION_MAX_TICKS=20
# TRIP_SIMULATION_BASE_SEED=7
# TRIP_SIMULATION_FAILURE_RATES={"get_weather_forecast":0.3,"get_trail_status":0.3,"check_guide_availability":0.2,"create_booking":0.3,"reserve_rental_gear":0.2}
# TRIP_SIMULATION_MAX_TOOL_ATTEMPTS=3
# TRIP_SIMULATION_RETRY_BASE_DELAY_S=0.2
# TRIP_SIMULATION_OUTPUT_DIR=trajectories
# TRIP_SIMULATION_LIVE_INPUT_TIMEOUT_S=1800   # play mode: wait for the user's reply
# TRIP_SIMULATION_MAX_LIVE_RUNS=20

# --- Weather ---
# TRIP_WEATHER_VARIANT=open_meteo   # or: fixture (offline)
# TRIP_WEATHER_LATITUDE=43.27
# TRIP_WEATHER_LONGITUDE=-4.98

# --- Observability (Langfuse; tracing is off without both keys) ---
# TRIP_OBSERVABILITY_ENABLED=true
# TRIP_OBSERVABILITY_LANGFUSE_PUBLIC_KEY=pk-lf-...
# TRIP_OBSERVABILITY_LANGFUSE_SECRET_KEY=sk-lf-...
# TRIP_OBSERVABILITY_LANGFUSE_HOST=http://localhost:3000
# (docker compose: the local Langfuse uses pk-lf-local-dev / sk-lf-local-dev)

# --- docker compose: self-hosted Langfuse (local defaults; change before exposing) ---
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=admin12345
# LANGFUSE_ENCRYPTION_KEY=   # openssl rand -hex 32
# LANGFUSE_SALT=
# LANGFUSE_NEXTAUTH_SECRET=
# POSTGRES_PASSWORD=postgres
# CLICKHOUSE_PASSWORD=clickhouse
# MINIO_ROOT_PASSWORD=miniosecret
# REDIS_AUTH=myredissecret
# LANGFUSE_PORT=3000
# MINIO_PORT=9090
# TRIP_PLANNER_PORT=8000
# FRONTEND_PORT=8080
